#X restore 20 405 pd saves;
#N canvas 50 50 2600 900 midi-out 0;
#X text 20 20 MIDI out: raw bytes and notes go through ac-midibyte / ac-noteout (so tests can watch them). Clock: 24 ticks a beat \, Start when a piece starts \, Stop at its end. Notes: the chord as voiced (base ch) \, tonic (+1) \, bells (+2) \, motion (+3) \, bass (+4) \, arp chord in close position (+5). Parts: all / harmony (no bells \, motion) / arp chord only.;
#X obj 20 44 midiout;
#X obj 20 68 r ac-midibyte;
#X obj 20 92 noteout;
#X obj 20 116 r ac-noteout;
#X obj 20 140 unpack f f f;
#X obj 250 20 r ac-tick;
#X obj 250 44 expr (acmout == 1 || acmout == 2) && acsync == 0 && acclkon;
#X obj 250 68 sel 0;
#X obj 250 92 b;
#X obj 250 116 expr 248;
#X obj 250 140 s ac-midibyte;
#X obj 480 20 r ac-clockstart;
#X obj 480 44 t b b;
#X obj 480 68 expr (acmout == 1 || acmout == 2) && acsync == 0;
#X obj 480 92 sel 0;
#X obj 480 116 b;
#X obj 480 140 t b b;
#X obj 480 164 expr if(acclkcont \, 251 \, 250);
#X obj 480 188 s ac-midibyte;
#X obj 480 212 expr 1;
#X obj 480 236 v acclkon;
#X obj 480 260 expr 0;
#X obj 480 284 v acclkcont;
#X obj 710 20 r ac-clockstop;
#X obj 710 44 t b b;
#X obj 710 68 expr acclkon;
#X obj 710 92 sel 0;
#X obj 710 116 b;
#X obj 710 140 t b b;
#X obj 710 164 expr 252;
#X obj 710 188 s ac-midibyte;
#X obj 710 212 expr 0;
#X obj 710 236 v acclkon;
#X obj 710 260 s ac-notesoff;
#X obj 940 20 r ac-outchord;
#X obj 940 44 expr acmout >= 2 && acrun;
#X obj 940 68 sel 0;
#X obj 940 92 b;
#X obj 940 116 t b b b b b;
#X obj 940 140 expr acmparts <= 1;
#X obj 940 164 sel 0;
#X obj 940 188 b;
#X obj 940 212 t b b;
#X obj 940 236 expr 4;
#X obj 940 260 t f b;
#X obj 940 284 f;
#X msg 940 308 0;
#X obj 940 332 until;
#X obj 940 356 + 1;
#X obj 940 380 t b f;
#X obj 940 404 v aci;
#X obj 940 428 expr acout[int(aci)] > 0;
#X obj 940 452 sel 0;
#X obj 940 476 b;
