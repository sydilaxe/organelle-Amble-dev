#X obj 250 380 expr \$f1 + (\$f2/1000 - 0.5)*0.14 \; if(\$f1 + (\$f2/1000 - 0.5)*0.14 > 0.95 \, 1.9 - \$f1 - (\$f2/1000 - 0.5)*0.14 \, if(\$f1 + (\$f2/1000 - 0.5)*0.14 < -0.95 \, -1.9 - \$f1 - (\$f2/1000 - 0.5)*0.14 \, \$f1 + (\$f2/1000 - 0.5)*0.14));
#X obj 250 404 random 1000;
