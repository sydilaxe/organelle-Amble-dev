#X text 20 20 MIDI out: raw bytes and notes go through ac-midibyte / ac-noteout (so tests can watch them). Clock: 24 ticks a beat \, Start when a piece starts \, Stop at its end. Notes: the chord as voiced (base ch) \, tonic (+1) \, bells (+2) \, motion (+3) \, bass (+4) \, arp chord in close position (+5). Parts: all / harmony (no bells \, motion) / arp chord only.;
#X obj 20 44 midiout;
#X obj 20 68 r ac-midibyte;
#X obj 20 92 noteout;
#X obj 20 116 r ac-noteout;
#X obj 20 140 unpack f f f;
#X obj 250 20 r ac-tick;
#X obj 250 44 expr (acmout == 1 || acmout == 2) && acsync == 0 && acclkon;
#X obj 250 68 sel 0;
#X obj 250 92 b;
#X obj 250 116 expr 248;
#X obj 250 140 s ac-midibyte;
#X obj 480 20 r ac-clockstart;
#X obj 480 44 expr (acmout == 1 || acmout == 2) && acsync == 0;
#X obj 480 68 sel 0;
