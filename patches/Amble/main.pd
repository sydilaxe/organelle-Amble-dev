#X obj 20 524 r ac-hintstop;
#X msg 20 548 stop;
#X obj 20 572 expr acauxheld || acauxused;
#X obj 20 596 v acauxused;
#X obj 20 620 expr ackn == 76 || ackn == 75;
#X obj 20 644 sel 0;
#X obj 20 668 b;
#X obj 20 692 expr 1 + (ackn == 75);
#X obj 20 716 v acrkey;
#X obj 20 740 expr ackn == 83;
