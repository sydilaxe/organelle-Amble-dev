#X obj 250 380 expr \$f1 + (\$f2/1000 - 0.5)*0.28*acshdp \; if(\$f1 + (\$f2/1000 - 0.5)*0.28*acshdp > 0.95 \, 1.9 - \$f1 - (\$f2/1000 - 0.5)*0.28*acshdp \, if(\$f1 + (\$f2/1000 - 0.5)*0.28*acshdp < -0.95 \, -1.9 - \$f1 - (\$f2/1000 - 0.5)*0.28*acshdp \, \$f1 + (\$f2/1000 - 0.5)*0.28*acshdp));
