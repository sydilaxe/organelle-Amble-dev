#N canvas 50 50 3600 900 section 0;
#X text 20 20 A section: its role (from the plan \, or chosen when drifting) sets layers \, key \, tempo \, harmonic pace \, motif \, rhythm and reverb;
#X obj 20 44 r ac-section;
#X obj 20 68 expr acmode==1 && acsec>=acnsec;
#X obj 20 92 sel 0;
#X obj 20 116 b;
#X obj 20 140 s ac-fin;
#X obj 20 164 t b b b b b b b;
#N canvas 50 50 2600 900 section-steps-1 0;
#X obj 20 20 inlet;
#X obj 20 44 t b b b b b b b b b b b b;
#X obj 20 68 s ac-rng;
#X obj 20 92 expr if(acmode==1 \, acroles[int(acsec)] \, if(acr1<0.25 \, 1 \, if(acr1<0.55 \, 2 \, if(acr1<0.8 \, 3 \, 5))));
#X obj 20 116 v acrole;
#X obj 20 140 expr if(acmode==1 \, acplan[int(acsec)] \, 0.3 + acr2*0.7);
#X obj 20 164 v acenergy;
#X obj 20 188 expr (acrests*acwrite) > 0 && (acrole == 0 || acrole == 5 || acrole == 7);
#X obj 20 212 v acsecalm;
#X obj 20 236 expr if(acchdc > 0 \, acchdc - 1 \, if(acrole==6 \, acfamA \, if(acr3<0.55 \, acfamA \, if(acr3<0.88 \, acfamB \, if(fmod(acr4*9.7 \, 1) < acharmx \, int(acr4*14) \, acplfam[int(acr4*9)])))));
#X obj 20 260 v acfam;
#X obj 20 284 s ac-rng;
#X obj 20 308 expr acrtide[int(acrole)] * (0.85 + acr1*0.3);
#X obj 20 332 v actidef;
#X obj 20 356 expr if(acrole == 5 && acr2 < 0.6 \, acdtype2 \, acdtype);
#X obj 20 380 v acdauto;
#X obj 20 404 expr min(1 \, max(0.3 \, 0.55 + 0.45*acenergy + (acr2-0.5)*0.25));
